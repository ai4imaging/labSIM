# Copy to .env and fill in YOUR own credentials. This repository ships no API
# key and no hosted endpoint. Only the provider you actually select needs a key.

# --- Option A: Anthropic -----------------------------------------------------
ANTHROPIC_API_KEY=
# AMX_LLM_PROVIDER=anthropic
# AMX_LLM_MODEL=claude-sonnet-4-5
# ARTICRAFT_MODEL=claude-sonnet-4-5

# --- Option B: OpenAI --------------------------------------------------------
OPENAI_API_KEY=
# AMX_LLM_PROVIDER=openai
# AMX_LLM_MODEL=gpt-4.1
# ARTICRAFT_MODEL=gpt-4.1

# --- Option C: your OpenAI-compatible gateway --------------------------------
# The variable names start with GPUGEEK_ for historical reasons. They are just
# the compatible-client key and base URL. Point them at an endpoint you control.
GPUGEEK_API_KEY=
GPUGEEK_BASE_URL=
# AMX_LLM_PROVIDER=gpugeek
# AMX_LLM_MODEL=
# GPUGEEK_MODEL=
# ARTICRAFT_MODEL=
# GPUGEEK_MAX_ATTEMPTS=12
# GPUGEEK_RETRY_BASE_SECONDS=1
# GPUGEEK_RETRY_MAX_SECONDS=60

# Which provider amx uses for the bench, the repair planner and the vision graders.
# Must match one of the options above that you filled in.
AMX_LLM_PROVIDER=
AMX_LLM_MODEL=

# The authoring agent reads ARTICRAFT_MODEL (and GPUGEEK_MODEL when the provider
# is the compatible client). Set them to a model id your endpoint actually serves.
# Run `amx llm doctor` after filling this file to list what it has.
ARTICRAFT_MODEL=

# --- Simulation --------------------------------------------------------------
# Headless rendering. Linux wants `egl` or `osmesa`. macOS: leave unset (CGL).
# MUJOCO_GL=egl
