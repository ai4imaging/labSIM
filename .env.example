# Copy to .env and fill in. Only the provider you actually select needs a key.

# --- LLM providers -----------------------------------------------------------
# `gpugeek` is an OpenAI-compatible gateway and is what this project is set up
# against; the other two talk to the vendors directly.
GPUGEEK_API_KEY=
GPUGEEK_BASE_URL=https://api.gpugeek.com/v1
# Gateway requests use equal-jitter exponential backoff and rebuild a broken
# connection pool before retrying. These defaults tolerate several-minute outages.
GPUGEEK_MAX_ATTEMPTS=12
GPUGEEK_RETRY_BASE_SECONDS=1
GPUGEEK_RETRY_MAX_SECONDS=60
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which model amx uses for the co-design proposer, the repair planner and the
# vision graders. A gateway's catalogue is its own: run `amx llm doctor` to see
# what it actually serves rather than guessing a model id.
AMX_LLM_PROVIDER=gpugeek
AMX_LLM_MODEL=Vendor2/Claude-4.8-opus

# --- Part 1: Articraft free-form asset authoring -----------------------------
# The authoring agent runs on the same gateway. Note that Articraft infers a
# provider from the model id and reads a bare `/` as OpenRouter, so gpugeek model
# ids are matched by their vendor prefix instead -- pass --provider explicitly if
# you use a model id that does not carry one.
GPUGEEK_MODEL=Vendor2/Claude-4.8-opus
ARTICRAFT_MODEL=Vendor2/Claude-4.8-opus
# When the selected model reports no capacity for longer than the retry budget, the run
# continues on the next of these rather than being thrown away an hour in. Strongest
# first; anything at or above the selected model is skipped.
# GPUGEEK_MODEL_FALLBACKS=Vendor2/Claude-4.8-opus,Vendor2/Claude-4.7-opus,Vendor2/Claude-4.6-opus,Vendor2/Claude-4.5-Sonnet

# The vendored Articraft tree. Leave unset to use vendor/articraft.
# ARTICRAFT_ROOT=

# Articraft's record store. Leave unset: it defaults beside the asset being
# generated. Example retrieval reads the vendored sdk/_examples and does not
# need this.
# ARTICRAFT_DATA_DIR=

# --- Simulation --------------------------------------------------------------
# Headless rendering backend for grounding screenshots. Linux wants `egl`;
# macOS has no EGL and MuJoCo reaches for CGL when this is unset, so leave it
# empty there.
# MUJOCO_GL=egl
